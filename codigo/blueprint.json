{
	"name": "Clasificador_Residuos",
	"flow": [
		{
			"id": 1,
			"module": "telegram:WatchUpdates",
			"version": 1,
			"mapper": {},
			"parameters": { "__IMTHOOK__": 2994951 },
			"metadata": {
				"designer": { "x": -172, "y": -14 },
				"parameters": [ { "name": "__IMTHOOK__", "type": "hook:telegramapi", "label": "Webhook", "required": true } ]
			}
		},
		{
			"id": 2,
			"module": "builtin:BasicRouter",
			"version": 1,
			"mapper": null,
			"metadata": { "designer": { "x": 128, "y": -14 } },
			"routes": [
				{
					"flow": [
						{
							"id": 3,
							"module": "telegram:DownloadFile",
							"version": 1,
							"filter": {
								"name": "Tiene foto",
								"conditions": [ [ { "a": "{{1.message.photo}}", "o": "exist" } ] ]
							},
							"parameters": { "__IMTCONN__": 12008824 },
							"mapper": { "fileId": "{{last(map(1.message.photo; \"file_id\"))}}" },
							"metadata": {
								"designer": { "x": 428, "y": -164 },
								"parameters": [ { "name": "__IMTCONN__", "type": "account:telegram", "label": "Connection", "required": true } ]
							}
						},
						{
							"id": 6,
							"module": "ai-local-agent:RunLocalAIAgent",
							"version": 0,
							"tools": [],
							"parameters": { "makeConnectionId": 10844322 },
							"mapper": {
								"files": [ { "data": "{{3.fileOutput}}", "fileName": "{{3.fileName}}" } ],
								"message": "Clasifica el residuo de la imagen.",
								"threadId": "",
								"outputType": "text",
								"tokenLimit": "50",
								"modelConfig": { "timeout": "", "recursionLimit": "300", "iterationsFromHistoryCount": "10" },
								"defaultModel": "medium",
								"systemPrompt": "Eres un asesor de separación de residuos para alumnos de Desarrollo Sustentable del TecNM en Mazatlán, Sinaloa.\n\nRecibirás la foto de un residuo. Responde en texto plano (sin asteriscos, sin markdown), en español, con este formato:\n\nResiduo: [qué es]\nMaterial: [material principal]\nClasificación: [orgánico / inorgánico reciclable / inorgánico no reciclable / manejo especial o peligroso]\n¿Se recicla?: [sí / no / depende, con una línea de explicación]\nDónde va: [contenedor o lugar de acopio]\nTiempo aproximado de degradación: [tiempo]\nConsejo: [1 línea para reducir o reutilizar este residuo]\n\nAntes de responder, observa bien toda la imagen y describe solo lo que realmente se ve; no inventes objetos que no aparezcan. Si en la foto hay varios residuos distintos, identifica el que ocupa el centro o la mayor parte de la imagen y, en la línea Consejo, menciona brevemente los demás que veas y que conviene separar por material.\n\nSi la imagen no muestra un residuo o no se distingue, responde: \"No pude identificar el residuo, envía otra foto más clara.\"\n\nSi es un residuo peligroso (pilas, medicamentos, aceite, químicos), indícalo y recomienda no tirarlo a la basura común.",
								"promptCaching": "none",
								"fallbackEnabled": false
							},
							"metadata": {
								"designer": { "x": 728, "y": -164 },
								"parameters": [ { "name": "makeConnectionId", "type": "account:ai-provider,openai-gpt-3,anthropic-claude,gemini-ai-q9zyjp,ai-agent-foundry-openai,ai-agent-foundry-non-openai,mistral-ai,cohere,groq,ai-agent-xai,amazon-bedrock,ai-agent-openai-compatible", "label": "Connection", "required": true } ]
							}
						},
						{
							"id": 7,
							"module": "telegram:SendReplyMessage",
							"version": 1,
							"parameters": { "__IMTCONN__": 12008824 },
							"mapper": {
								"text": "{{6.response}}",
								"chatId": "{{1.message.chat.id}}",
								"parseMode": "",
								"replyMarkup": "",
								"messageThreadId": "",
								"replyToMessageId": "",
								"replyMarkupAssembleType": "reply_markup_enter"
							},
							"metadata": {
								"designer": { "x": 1028, "y": -164 },
								"parameters": [ { "name": "__IMTCONN__", "type": "account:telegram", "label": "Connection", "required": true } ]
							}
						}
					]
				},
				{
					"flow": [
						{
							"id": 4,
							"module": "telegram:SendReplyMessage",
							"version": 1,
							"filter": {
								"name": "No tiene foto",
								"conditions": [ [
									{ "a": "{{1.message}}", "o": "exist" },
									{ "a": "{{1.message.photo}}", "o": "notexist" }
								] ]
							},
							"parameters": { "__IMTCONN__": 12008824 },
							"mapper": {
								"text": "📸 Envíame la foto de un residuo para decirte qué es, si se recicla y en qué contenedor va.",
								"chatId": "{{1.message.chat.id}}",
								"parseMode": "",
								"replyMarkup": "",
								"messageThreadId": "",
								"replyToMessageId": "",
								"replyMarkupAssembleType": "reply_markup_enter"
							},
							"metadata": {
								"designer": { "x": 428, "y": 136 },
								"parameters": [ { "name": "__IMTCONN__", "type": "account:telegram", "label": "Connection", "required": true } ]
							}
						}
					]
				}
			]
		}
	],
	"metadata": {
		"instant": true,
		"version": 1,
		"designer": { "orphans": [] },
		"scenario": {
			"dlq": false,
			"slots": null,
			"dataloss": false,
			"maxErrors": 3,
			"autoCommit": true,
			"roundtrips": 1,
			"sequential": false,
			"confidential": false,
			"freshVariables": false,
			"autoCommitTriggerLast": true
		}
	}
}
